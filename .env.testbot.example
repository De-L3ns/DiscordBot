# Docker Compose profile settings. Keep these values separate from production.
KLETSERBOT_ENV_FILE=.env.testbot
KLETSERBOT_IMAGE=kletserbot:test
CARDPACK_DATA_VOLUME=kletserbot-test-cardpack-data

# This must be a separate Discord application and dedicated test guild.
BOT_MODE=test
DISCORD_TOKEN=replace-with-test-discord-token
BIRTHDAY_CHANNEL_ID=123456789012345678
REACTION_ROLE_MESSAGE_ID=123456789012345678
IMGUR_CLIENT_ID=replace-with-imgur-client-id
IMGUR_ALBUM_KEY=replace-with-imgur-album-key
SPORZA_LEAGUE_URL=https://example.invalid/sporza-league

# Commands are synchronized only to this dedicated test guild.
DISCORD_DEVELOPMENT_GUILD_ID=123456789012345678
BOT_TIMEZONE=Europe/Brussels

# Keep background notifications disabled unless they target a test channel.
ENABLE_WIELERMANAGER_POLLING=false
WIELERMANAGER_CHANNEL_ID=
WIELERMANAGER_POLL_INTERVAL_MINUTES=15

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3
POKEMON_TCG_API_KEY=
CARDPACK_DATA_DIRECTORY=data/cardpacks
CARDPACK_HIT_CHANNEL_ID=
CARDPACK_SET_CATALOG_PATH=
CARDPACK_PULL_RATES_PATH=
