DISCORD_TOKEN=replace-with-discord-token
BIRTHDAY_CHANNEL_ID=123456789012345678
REACTION_ROLE_MESSAGE_ID=123456789012345678
IMGUR_CLIENT_ID=replace-with-imgur-client-id
IMGUR_ALBUM_KEY=replace-with-imgur-album-key
SPORZA_LEAGUE_URL=https://example.invalid/sporza-league

ENABLE_WIELERMANAGER_POLLING=false
# Required only when polling is enabled:
WIELERMANAGER_CHANNEL_ID=
WIELERMANAGER_POLL_INTERVAL_MINUTES=15

BOT_TIMEZONE=Europe/Brussels
# Optional: faster slash-command synchronization during development.
DISCORD_DEVELOPMENT_GUILD_ID=

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3

# Optional. Unauthenticated Pokémon TCG API access uses lower rate limits.
POKEMON_TCG_API_KEY=
# Compose overrides this with its persistent named-volume mount.
CARDPACK_DATA_DIRECTORY=data/cardpacks
# Optional configuration overrides:
CARDPACK_SET_CATALOG_PATH=
CARDPACK_PULL_RATES_PATH=
